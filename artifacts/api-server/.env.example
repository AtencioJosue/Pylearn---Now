# Local development can use the JSON fallback. Production must use PostgreSQL.
DATABASE_URL=
USE_REMOTE_DATABASE=true

# Transactional email. Never commit real values.
RESEND_API_KEY=
EMAIL_FROM="Pylearn <no-reply@your-verified-domain.com>"

# Vercel Blob Read/Write token for persistent avatars and forum images.
BLOB_READ_WRITE_TOKEN=

# Keep AI keys server-side only.
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Optional local-development CORS origin.
CORS_ORIGIN=http://localhost:5173

# Comma-separated user IDs allowed to run admin league actions.
ADMIN_USER_IDS=

# Only use temporarily in local development when no email provider is configured.
AUTH_ALLOW_DEV_CODES=false
